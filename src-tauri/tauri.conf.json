{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atto",
  "version": "0.1.0",
  "identifier": "com.atto.assistant",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Atto",
        "width": 460,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
