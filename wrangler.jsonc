{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frontend",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application"
  }
}
